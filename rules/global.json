{
  "version": 1,
  "name": "Twe global rules",
  "rules": [
    {
      "id": "wpdiscuz",
      "name": "wpDiscuz",
      "match": {
        "detect": "#wpdcom, .wpd-thread-list, .wpd-comment"
      },
      "type": "page",
      "page": {
        "wait": ".wpd-comment",
        "item": ".wpd-comment",
        "author": ".wpd-comment-author",
        "text": ".wpd-comment-text",
        "time": ".wpd-comment-date",
        "avatar": ".wpd-avatar img, img",
        "likes": ".wpd-vote-result",
        "spoiler": ".wpd-spoiler, .spoiler",
        "more": ".wpd-load-more-submit",
        "total": ".wpd-thread-info",
        "totalAttr": "data-comments-count",
        "replyCount": ".wpd-toggle .wpd-view-replies",
        "repliesToggle": ".wpd-toggle"
      },
      "actions": {
        "login": "{origin}/wp-login.php",
        "loggedOut": "wc_login_to_vote",
        "ids": {
          "cid": "wpd-comm-(\\d+)_",
          "uid": "wpd-comm-(.+)$"
        },
        "like": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdVoteOnComment&commentId={cid}&voteType=1&postId={js:wpdiscuzAjaxObj.wc_post_id}"
        },
        "dislike": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdVoteOnComment&commentId={cid}&voteType=-1&postId={js:wpdiscuzAjaxObj.wc_post_id}"
        },
        "post": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdAddComment&wc_comment={text}&wpdiscuz_unique_id=0_0&wpd_comment_depth=1&wp_manga_chapter_id={mangaChapter}&postId={js:wpdiscuzAjaxObj.wc_post_id}&wpdiscuz_zs={js:wpdiscuzAjaxObj.wpdiscuz_zs}"
        },
        "reply": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdAddComment&wc_comment={text}&wpdiscuz_unique_id={uid}&wpd_comment_depth={replyDepth}&wp_manga_chapter_id={mangaChapter}&postId={js:wpdiscuzAjaxObj.wc_post_id}&wpdiscuz_zs={js:wpdiscuzAjaxObj.wpdiscuz_zs}"
        }
      },
      "vars": {
        "mangaChapter": {
          "from": "page",
          "selector": "input[name=wp_manga_chapter_id]",
          "attr": "value",
          "fallback": [
            {
              "from": "value",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "id": "mcs",
      "name": "Manga Comments System",
      "match": {
        "detect": "li.mcs-comment"
      },
      "type": "page",
      "page": {
        "item": "li.mcs-comment",
        "author": ".mcs-comment-author",
        "time": "time.mcs-comment-date",
        "text": ".mcs-comment-content-view",
        "avatar": ".mcs-comment-avatar__img"
      }
    },
    {
      "id": "comment-body-articles",
      "name": "Article comments",
      "match": {
        "detect": "article.comment-body[id^='div-comment-']"
      },
      "type": "page",
      "page": {
        "item": "article.comment-body[id^='div-comment-']",
        "author": ".comment-author .fn",
        "text": ".comment-content",
        "time": ".comment-metadata",
        "avatar": ".comment-avatar img"
      }
    },
    {
      "id": "livewire-discussion",
      "name": "Discussion (Livewire)",
      "match": {
        "detect": "[data-testid='comment-discussion']"
      },
      "type": "page",
      "page": {
        "item": "article[data-testid='comment-card']",
        "author": "a[href*='/users/'].font-semibold, a[href*='/users/']:not(.shrink-0)",
        "time": "time",
        "text": ".comment-content",
        "avatar": "img",
        "spoiler": ".comment-spoiler"
      }
    },
    {
      "id": "manga-comments-pro",
      "name": "Manga Comments Pro",
      "match": {
        "detect": "#mcp-list, .mcp-thread"
      },
      "type": "page",
      "page": {
        "item": ".mcp-thread",
        "author": ".mcp-author",
        "time": ".mcp-time",
        "text": ".mcp-content",
        "likes": ".mcp-like-count",
        "avatar": "img.mcp-avatar"
      }
    },
    {
      "id": "discourse",
      "name": "Discourse",
      "match": {
        "detect": "[data-discourse-url], #discourse-comments"
      },
      "type": "page",
      "vars": {
        "forum": {
          "from": "fetch",
          "regex": "data-discourse-url=\"([^\"]+?)/?\"",
          "fallback": [
            {
              "from": "fetch",
              "regex": "discourseUrl\\s*:\\s*['\"]([^'\"]+?)/?['\"]"
            }
          ]
        }
      },
      "entry": {
        "url": "{forum}/embed/comments?embed_url={pageUrl}"
      },
      "chapter": {
        "url": "{forum}/embed/comments?embed_url={pageUrl}"
      },
      "page": {
        "item": "article.post",
        "author": ".username",
        "time": ".post-date",
        "text": ".cooked",
        "avatar": ".author img"
      }
    },
    {
      "id": "disqus",
      "name": "Disqus",
      "match": {
        "detect": "#disqus_thread"
      },
      "type": "disqus",
      "vars": {
        "forum": {
          "from": "html",
          "regex": "//([a-z0-9-]+)\\.disqus\\.com/(?:embed|count)\\.js"
        },
        "identifier": {
          "from": "html",
          "regex": "(?:this\\.page\\.identifier|disqus_identifier)\\s*=\\s*['\"]([^'\"]+)"
        },
        "threadUrl": {
          "from": "html",
          "regex": "(?:this\\.page\\.url|disqus_url)\\s*=\\s*['\"]([^'\"]+)"
        }
      },
      "disqus": {
        "forum": "{forum}",
        "identifier": "{identifier}",
        "url": "{threadUrl}"
      }
    },
    {
      "id": "blogger",
      "name": "Blogger comments",
      "match": {
        "detect": "meta[name='generator'][content='blogger' i], link[href*='blogger.com/feeds']"
      },
      "type": "api",
      "vars": {
        "postId": {
          "from": "fetch",
          "regex": "postId['\"]?\\s*[:=]\\s*['\"]?(\\d{8,})",
          "fallback": [
            {
              "from": "fetch",
              "regex": "post-body-(\\d{15,})"
            }
          ]
        }
      },
      "api": {
        "url": "{origin}/feeds/{postId}/comments/default?alt=json&max-results=100",
        "list": "feed.entry",
        "id": "id.$t",
        "author": "author.0.name.$t",
        "avatar": "author.0.gd$image.src",
        "text": "content.$t",
        "html": true,
        "time": "published.$t",
        "total": "feed.openSearch$totalResults.$t"
      }
    },
    {
      "id": "wordpress",
      "name": "WordPress comments",
      "match": {
        "detect": ".comment-list li.comment, ol.commentlist li.comment, #comments article.comment"
      },
      "type": "page",
      "page": {
        "item": "li.comment, article.comment",
        "author": ".comment-author .fn, .comment-author b, .fn",
        "text": ".comment-content, .comment-body > p, .comment-text",
        "time": ".comment-metadata time, .comment-meta a, time",
        "avatar": ".avatar, img"
      }
    },
    {
      "id": "facebook",
      "name": "Facebook comments",
      "match": {
        "detect": ".fb-comments, iframe[src*='facebook.com/plugins/comments']"
      },
      "type": "unsupported",
      "message": "This site uses Facebook comments, which only show inside Facebook's own frame. Open the page in WebView to read them."
    }
  ]
}
