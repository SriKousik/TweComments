{
  "version": 1,
  "name": "Twe global rules",
  "rules": [
    {
      "id": "wpdiscuz",
      "name": "wpDiscuz",
      "match": {
        "detect": "#wpdcom, .wpd-thread-list, .wpd-comment"
      },
      "type": "page",
      "page": {
        "wait": ".wpd-comment",
        "item": ".wpd-comment",
        "author": ".wpd-comment-author",
        "text": ".wpd-comment-text",
        "time": ".wpd-comment-date",
        "avatar": ".wpd-avatar img, img",
        "likes": ".wpd-vote-result",
        "spoiler": ".wpd-spoiler, .spoiler",
        "more": ".wpd-load-more-submit",
        "total": ".wpd-thread-info",
        "totalAttr": "data-comments-count",
        "replyCount": ".wpd-toggle .wpd-view-replies",
        "repliesToggle": ".wpd-toggle"
      },
      "actions": {
        "login": "{origin}/wp-login.php",
        "loggedOut": "wc_login_to_vote",
        "ids": {
          "cid": "wpd-comm-(\\d+)_",
          "uid": "wpd-comm-(.+)$"
        },
        "like": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdVoteOnComment&commentId={cid}&voteType=1&postId={js:wpdiscuzAjaxObj.wc_post_id}"
        },
        "dislike": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdVoteOnComment&commentId={cid}&voteType=-1&postId={js:wpdiscuzAjaxObj.wc_post_id}"
        },
        "post": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdAddComment&wc_comment={text}&wpdiscuz_unique_id=0_0&wpd_comment_depth=1&wp_manga_chapter_id={mangaChapter}&postId={js:wpdiscuzAjaxObj.wc_post_id}&wpdiscuz_zs={js:wpdiscuzAjaxObj.wpdiscuz_zs}"
        },
        "reply": {
          "url": "{origin}/wp-admin/admin-ajax.php",
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          "body": "action=wpdAddComment&wc_comment={text}&wpdiscuz_unique_id={uid}&wpd_comment_depth={replyDepth}&wp_manga_chapter_id={mangaChapter}&postId={js:wpdiscuzAjaxObj.wc_post_id}&wpdiscuz_zs={js:wpdiscuzAjaxObj.wpdiscuz_zs}"
        }
      },
      "vars": {
        "mangaChapter": {
          "from": "page",
          "selector": "input[name=wp_manga_chapter_id]",
          "attr": "value",
          "fallback": [
            {
              "from": "value",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "id": "disqus",
      "name": "Disqus",
      "match": {
        "detect": "#disqus_thread"
      },
      "type": "disqus",
      "vars": {
        "forum": {
          "from": "html",
          "regex": "//([a-z0-9-]+)\\.disqus\\.com/(?:embed|count)\\.js"
        },
        "identifier": {
          "from": "html",
          "regex": "(?:this\\.page\\.identifier|disqus_identifier)\\s*=\\s*['\"]([^'\"]+)"
        },
        "threadUrl": {
          "from": "html",
          "regex": "(?:this\\.page\\.url|disqus_url)\\s*=\\s*['\"]([^'\"]+)"
        }
      },
      "disqus": {
        "forum": "{forum}",
        "identifier": "{identifier}",
        "url": "{threadUrl}"
      }
    },
    {
      "id": "wordpress",
      "name": "WordPress comments",
      "match": {
        "detect": ".comment-list li.comment, ol.commentlist li.comment, #comments article.comment"
      },
      "type": "page",
      "page": {
        "item": "li.comment, article.comment",
        "author": ".comment-author .fn, .comment-author b, .fn",
        "text": ".comment-content, .comment-body > p, .comment-text",
        "time": ".comment-metadata time, .comment-meta a, time",
        "avatar": ".avatar, img"
      }
    },
    {
      "id": "facebook",
      "name": "Facebook comments",
      "match": {
        "detect": ".fb-comments, iframe[src*='facebook.com/plugins/comments']"
      },
      "type": "unsupported",
      "message": "This site uses Facebook comments, which only show inside Facebook's own frame. Open the page in WebView to read them."
    }
  ]
}
