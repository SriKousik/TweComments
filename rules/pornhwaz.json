{
  "version": 1,
  "name": "Pornhwaz comments",
  "rules": [
    {
      "id": "pornhwaz",
      "name": "Pornhwaz comments",
      "type": "page",
      "page": {
        "wait": ".wbtz-comment-item",
        "item": ".wbtz-comment-item",
        "author": ".wbtz-author-name",
        "text": ".wbtz-comment-text-body",
        "time": "time",
        "avatar": "img.wbtz-avatar-img",
        "likes": ".wbtz-upvote",
        "spoiler": ".wbtz-spoiler",
